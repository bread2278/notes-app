# Copy this file to .env.local and fill in your own values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys, and never put a secret
# behind a NEXT_PUBLIC_ prefix (those are bundled into the browser).

# Supabase Dashboard -> Project Settings -> API. Public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Supabase Dashboard -> Project Settings -> API Keys -> Secret keys (sb_secret_...).
# Used only for the weather_cache table; without it the cache is skipped.
SUPABASE_SECRET_KEY=

# Server-only. https://www.weatherapi.com/ -> your account's API key.
WEATHER_API_KEY=

# Development only: true = note saves/deletes fail, load = loading notes fails too.
SIMULATE_DB_ERROR=false
